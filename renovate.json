{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "before 6am on monday"
  ],
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "internalChecksFilter": "strict",
  "internalChecksAsSuccess": true,
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "platformAutomerge": true,
    "vulnerabilityFixStrategy": "lowest"
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "matchManagers": [
        "ruby-version"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "matchDepNames": [
        "ruby"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "bundler"
      ],
      "groupName": "Ruby gems"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Container base images"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on the first day of the month"
    ]
  },
  "npmrc": "allow-remote=all\n"
}
